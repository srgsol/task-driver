# task-driver credentials.
#
# Copy this file to `.env` (git-ignored) and fill in the values. task-driver
# loads `.env` from the project root on every run, before it resolves
# credentials; a real environment variable always wins over a value here, and a
# missing `.env` is not an error.

# Linear — needed when any repo uses provider "linear" (the default).
LINEAR_API_KEY=

# Jira Cloud — needed when any repo uses provider "jira". Authenticates with
# HTTP Basic against the top-level `jiraBaseUrl` in task-driver.config.json.
JIRA_EMAIL=
JIRA_API_TOKEN=
