{
  "name": "task-driver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "task-driver": "node src/cli.mjs",
    "task-driver:dry": "node src/cli.mjs --dry-run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{mjs,js,cjs,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "prettier-plugin-jsdoc": "^1.8.1",
    "typescript": "~5.9.0"
  }
}
